# Neon pooled PostgreSQL URL used by the deployed application and Prisma Client.
DATABASE_URL="postgresql://user:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Auth (Must be at least 32 characters in production)
SESSION_SECRET="workpulse_secret_key_change_in_production_32chars!"

# Canonical SaaS hosts. Production: workpulse.com and https://workpulse.com.
PLATFORM_ROOT_DOMAIN="localhost:3000"
PLATFORM_PUBLIC_ORIGIN="http://localhost:3000"

# Vercel Blob private object storage. Required in Vercel Production and Preview.
# Created automatically when a Blob store is connected to the Vercel project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"

# Google Gemini API Key (Required for AI Resume Parsing & Candidate Matching)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY="your-google-ai-studio-api-key-here"

# Email Notifications (Free Gmail SMTP / App Password)
# Optional in development: If left blank or omitted, emails are captured in the in-memory logger & console.
# To send actual live emails, generate a 16-character Google App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
EMAIL_FROM="your-email@gmail.com"
DEMO_REQUEST_EMAIL="workpulse-demo-inbox@example.com"

# Generic SMTP alternative to Gmail. Use either Gmail credentials above or this group.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
