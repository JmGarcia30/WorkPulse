+]) test(`PhilHealth salary ${salary}: floor/ceiling/odd cent`, () => amounts(ph(salary), ee, er));
+
+test('PhilHealth published 2018 rounding examples (rounding only, not obsolete rate)', () => {
+  for (const [total, ee, er] of [['309.375', '154.69', '154.69'], ['698.775', '349.39', '349.39'], ['618.75', '309.37', '309.38']]) {
