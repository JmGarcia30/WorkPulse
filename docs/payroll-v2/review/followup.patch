+  ['10000', '200', '200'], ['10000.01', '200', '200'], ['100000', '200', '200'],
+]) test(`Pag-IBIG Circular 460 rates: salary ${salary}`, () => amounts(pi(salary), ee, er));
+
+test('Pag-IBIG does not invent a fractional-centavo rounding rule', () => {
+  for (const salary of ['1499.99', '1500.01', '9999.99']) rejects(() => pi(salary), 'ROUNDING_UNVERIFIED');
+});
+
+test('Each agency uses its own explicitly resolved monthly basis', () => {
+  amounts(sss('25000'), '1250', '2500', '30');
+  amounts(ph('20000'), '500', '500');
+  amounts(pi('22000'), '200', '200');
+});
+
+test('Effective dates inclusive; unsupported history and future fail closed', () => {
