generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZATION_ADMIN
  HR_ADMIN
  HIRING_MANAGER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum EmploymentCategory {
  TEACHING
  NON_TEACHING
}

enum RequirementType {
  SKILL
  EDUCATION
  EXPERIENCE
  CERTIFICATION
  OTHER
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  INITIAL_SCREENING
  TECHNICAL
  BEHAVIORAL
  FINAL
  TEACHING_DEMONSTRATION
  HEAD_OF_DEPARTMENT
  PRESIDENT_FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EvaluationRecommendation {
  STRONGLY_RECOMMEND
  RECOMMEND
  MAYBE
  DO_NOT_RECOMMEND
}

enum AssessmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  PASSED
  FAILED
  EXPIRED
  CANCELLED
}

enum AssessmentType {
  TECHNICAL
  SKILLS
  COGNITIVE
  BEHAVIORAL
  ROLE_SPECIFIC
  WRITTEN_EXAMINATION
  OTHER
}

enum RecruitmentDocumentType {
  RESUME_APPLICATION_LETTER
  TRANSCRIPT_OF_RECORDS
  DIPLOMA
  LET_BASIC_EDUCATION
  PROFESSIONAL_LICENSE
  PREVIOUS_EMPLOYMENT_CERT
  RECOMMENDATION_LETTER_1
  RECOMMENDATION_LETTER_2
  RECOMMENDATION_LETTER_3
  NBI_CLEARANCE
  MARRIAGE_CONTRACT
  OTHER
}

enum RecruitmentDocumentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
  NOT_APPLICABLE
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum PayFrequency {
  ANNUAL
  MONTHLY
  BIWEEKLY
  WEEKLY
  HOURLY
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnboardingTaskType {
  DOCUMENT
  EQUIPMENT
  ADMIN
  ORIENTATION
  OTHER
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  REJECTED
  WAIVED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SEPARATED
}

enum EmploymentStatus {
  PROBATIONARY
  REGULAR
}

enum ProbationStatus {
  ACTIVE
  CLOSED
}

enum ProbationDecision {
  PENDING
  REGULARIZED
  RENEWED
  NOT_RENEWED
}

enum AttendanceDirection {
  TIME_IN
  TIME_OUT
}

enum AttendanceSource {
  MANUAL
  IMPORT
  RFID
}

enum AttendanceStatus {
  OPEN
  PRESENT
  ABSENT
  INCOMPLETE
  REST_DAY
  NO_SCHEDULE
}

enum AttendanceDerivation {
  RAW_EVENTS
  CORRECTED
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String?  @db.Text
  logoUrl              String?
  careersEnabled       Boolean  @default(true)
  employeeNumberPrefix String?
  timeZone             String   @default("UTC")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                   User[]
  jobs                    Job[]
  employees               Employee[]
  employeeNumberSequences EmployeeNumberSequence[]
  workScheduleGroups      WorkScheduleGroup[]
  scheduleAssignments     EmployeeScheduleAssignment[]
  attendanceEvents        AttendanceEvent[]
  dailyAttendanceRecords  DailyAttendanceRecord[]
  attendanceCorrections   AttendanceCorrection[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(HR_ADMIN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                 Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statusChanges                ApplicationStatusHistory[]
  interviews                   Interview[]
  evaluations                  CandidateEvaluation[]
  evaluationsAssessed          Assessment[]
  offersCreated                Offer[]                      @relation("OfferCreatedBy")
  offersApproved               Offer[]                      @relation("OfferApprovedBy")
  verifiedOnboardingTasks      OnboardingTask[]
  verifiedRecruitmentDocs      RecruitmentDocument[]
  employeesCreated             Employee[]                   @relation("EmployeeCreatedBy")
  employmentRecordsCreated     EmploymentRecord[]           @relation("EmploymentRecordCreatedBy")
  probationDecisions           ProbationRecord[]            @relation("ProbationDecisionBy")
  employmentDecisions          EmploymentDecisionHistory[]
  employeeStatusChanges        EmployeeStatusHistory[]
  workScheduleGroupsCreated    WorkScheduleGroup[]          @relation("WorkScheduleGroupCreatedBy")
  workScheduleVersionsCreated  WorkScheduleVersion[]        @relation("WorkScheduleVersionCreatedBy")
  scheduleAssignmentsCreated   EmployeeScheduleAssignment[] @relation("ScheduleAssignmentCreatedBy")
  attendanceEventsCreated      AttendanceEvent[]            @relation("AttendanceEventCreatedBy")
  attendanceCorrectionsCreated AttendanceCorrection[]       @relation("AttendanceCorrectionCreatedBy")

  @@index([organizationId])
}

model Job {
  id               String             @id @default(cuid())
  organizationId   String
  title            String
  slug             String
  department       String
  employmentType   String
  location         String
  description      String             @db.Text
  responsibilities String             @db.Text
  qualifications   String             @db.Text
  requirements     String             @db.Text
  status           JobStatus          @default(DRAFT)
  category         EmploymentCategory @default(NON_TEACHING)
  publishedAt      DateTime?
  closingDate      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  structuredReqs    JobRequirement[]
  applications      Application[]
  employmentRecords EmploymentRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

model JobRequirement {
  id          String          @id @default(cuid())
  jobId       String
  name        String
  type        RequirementType @default(SKILL)
  description String?         @db.Text
  isRequired  Boolean         @default(true)
  createdAt   DateTime        @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Applicant {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  documents    Document[]
  employees    Employee[]

  @@index([email])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  applicantId String
  status      ApplicationStatus @default(APPLIED)
  coverLetter String            @db.Text
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job                  Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant            Applicant                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  documents            Document[]
  recruitmentDocuments RecruitmentDocument[]
  history              ApplicationStatusHistory[]
  interviews           Interview[]
  assessments          Assessment[]
  offers               Offer[]
  onboarding           OnboardingProcess?
  employee             Employee?

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
  @@index([appliedAt])
}

model Document {
  id            String   @id @default(cuid())
  applicantId   String
  applicationId String?
  fileName      String
  fileType      String
  fileSize      Int
  storageKey    String
  createdAt     DateTime @default(now())

  applicant    Applicant     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  application  Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  parsedResume ParsedResume?

  @@index([applicantId])
  @@index([applicationId])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus
  toStatus      ApplicationStatus
  changedById   String
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([applicationId])
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String
  interviewerId   String
  scheduledAt     DateTime
  durationMinutes Int             @default(45)
  type            InterviewType   @default(INITIAL_SCREENING)
  location        String?
  meetingUrl      String?
  notes           String?         @db.Text
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User                 @relation(fields: [interviewerId], references: [id])
  evaluation  CandidateEvaluation?

  @@index([applicationId])
  @@index([interviewerId])
  @@index([status])
  @@index([scheduledAt])
}

model CandidateEvaluation {
  id                  String                   @id @default(cuid())
  interviewId         String                   @unique
  communicationScore  Int
  technicalScore      Int
  problemSolvingScore Int
  experienceScore     Int
  cultureFitScore     Int
  overallScore        Float
  recommendation      EvaluationRecommendation
  comments            String                   @db.Text
  evaluatedById       String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluatedBy User      @relation(fields: [evaluatedById], references: [id])

  @@index([interviewId])
  @@index([evaluatedById])
}

model Assessment {
  id            String           @id @default(cuid())
  applicationId String
  title         String
  type          AssessmentType   @default(TECHNICAL)
  description   String?          @db.Text
  dueDate       DateTime?
  status        AssessmentStatus @default(ASSIGNED)
  score         Float?
  maxScore      Float?
  passingScore  Float?
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  evaluatorId   String?
  reviewerNotes String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluator   User?       @relation(fields: [evaluatorId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@index([evaluatorId])
}

model Offer {
  id                        String       @id @default(cuid())
  applicationId             String
  salary                    Float
  payFrequency              PayFrequency @default(MONTHLY)
  employmentType            String
  startDate                 DateTime
  expirationDate            DateTime?
  benefits                  String?      @db.Text
  allowances                String?      @db.Text
  additionalTerms           String?      @db.Text
  notes                     String?      @db.Text
  status                    OfferStatus  @default(DRAFT)
  contractSignedByPresident Boolean      @default(false)
  contractSignedByEmployee  Boolean      @default(false)
  contractExecutedAt        DateTime?
  probationPeriodMonths     Int?
  probationaryTerms         String?      @db.Text
  createdById               String
  approvedById              String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("OfferCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?             @relation("OfferApprovedBy", fields: [approvedById], references: [id])
  employmentRecord EmploymentRecord?

  @@index([applicationId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model EmployeeNumberSequence {
  organizationId String
  year           Int
  nextValue      Int      @default(1)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, year])
}

model Employee {
  id                  String         @id @default(cuid())
  organizationId      String
  sourceApplicationId String         @unique
  applicantId         String
  employeeNumber      String
  firstName           String
  lastName            String
  email               String
  phone               String
  employeeStatus      EmployeeStatus @default(ACTIVE)
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceApplication      Application                  @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)
  applicant              Applicant                    @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  createdBy              User                         @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  employmentRecords      EmploymentRecord[]
  probationRecords       ProbationRecord[]
  employmentDecisions    EmploymentDecisionHistory[]
  statusHistory          EmployeeStatusHistory[]
  scheduleAssignments    EmployeeScheduleAssignment[]
  attendanceEvents       AttendanceEvent[]
  dailyAttendanceRecords DailyAttendanceRecord[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, applicantId])
  @@index([organizationId, employeeStatus])
  @@index([applicantId])
}

model EmploymentRecord {
  id                 String             @id @default(cuid())
  employeeId         String
  jobId              String?
  acceptedOfferId    String?            @unique
  jobTitle           String
  department         String
  employmentCategory EmploymentCategory
  employmentType     String
  hireDate           DateTime
  startDate          DateTime
  salary             Decimal            @db.Decimal(12, 2)
  payFrequency       PayFrequency
  employmentStatus   EmploymentStatus   @default(PROBATIONARY)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  employee               Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  job                    Job?                        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  acceptedOffer          Offer?                      @relation(fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  createdBy              User                        @relation("EmploymentRecordCreatedBy", fields: [createdById], references: [id])
  probation              ProbationRecord?
  decisionsFrom          EmploymentDecisionHistory[] @relation("EmploymentDecisionPreviousRecord")
  decisionsTo            EmploymentDecisionHistory[] @relation("EmploymentDecisionResultingRecord")
  dailyAttendanceRecords DailyAttendanceRecord[]

  @@index([employeeId])
  @@index([jobId])
  @@index([employmentStatus])
  @@index([effectiveFrom, effectiveTo])
}

model ProbationRecord {
  id                        String             @id @default(cuid())
  employeeId                String
  employmentRecordId        String             @unique
  category                  EmploymentCategory
  startedAt                 DateTime
  expectedEndAt             DateTime
  probationStatus           ProbationStatus    @default(ACTIVE)
  renewalCount              Int                @default(0)
  maxRenewals               Int                @default(0)
  completedAt               DateTime?
  decision                  ProbationDecision  @default(PENDING)
  decisionAt                DateTime?
  decisionById              String?
  policySnapshot            String             @db.Text
  remarks                   String?            @db.Text
  previousProbationRecordId String?            @unique
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  employee                Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentRecord        EmploymentRecord           @relation(fields: [employmentRecordId], references: [id], onDelete: Cascade)
  decisionBy              User?                      @relation("ProbationDecisionBy", fields: [decisionById], references: [id], onDelete: Restrict)
  previousProbationRecord ProbationRecord?           @relation("ProbationRenewals", fields: [previousProbationRecordId], references: [id], onDelete: SetNull)
  nextProbationRecord     ProbationRecord?           @relation("ProbationRenewals")
  decisionHistory         EmploymentDecisionHistory?

  @@index([employeeId])
  @@index([probationStatus, expectedEndAt])
  @@index([decisionById])
}

model EmploymentDecisionHistory {
  id                          String            @id @default(cuid())
  employeeId                  String
  probationRecordId           String            @unique
  previousEmploymentRecordId  String
  resultingEmploymentRecordId String?
  decision                    ProbationDecision
  decisionAt                  DateTime
  effectiveAt                 DateTime
  changedById                 String
  remarks                     String?           @db.Text
  previousState               Json
  newState                    Json
  createdAt                   DateTime          @default(now())

  employee                  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  probationRecord           ProbationRecord   @relation(fields: [probationRecordId], references: [id], onDelete: Restrict)
  previousEmploymentRecord  EmploymentRecord  @relation("EmploymentDecisionPreviousRecord", fields: [previousEmploymentRecordId], references: [id], onDelete: Restrict)
  resultingEmploymentRecord EmploymentRecord? @relation("EmploymentDecisionResultingRecord", fields: [resultingEmploymentRecordId], references: [id], onDelete: Restrict)
  changedBy                 User              @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([employeeId, decisionAt])
  @@index([changedById])
  @@index([previousEmploymentRecordId])
  @@index([resultingEmploymentRecordId])
}

model EmployeeStatusHistory {
  id          String          @id @default(cuid())
  employeeId  String
  fromStatus  EmployeeStatus?
  toStatus    EmployeeStatus
  changedById String
  reason      String          @db.Text
  createdAt   DateTime        @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([employeeId, createdAt])
  @@index([changedById])
}

model WorkScheduleGroup {
  id             String   @id @default(cuid())
  organizationId String
  scheduleKey    String
  name           String
  description    String?  @db.Text
  isArchived     Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation("WorkScheduleGroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions     WorkScheduleVersion[]

  @@unique([organizationId, scheduleKey])
  @@index([organizationId, isArchived])
  @@index([createdById])
}

model WorkScheduleVersion {
  id               String   @id @default(cuid())
  scheduleGroupId  String
  version          Int
  displayName      String
  lateGraceSeconds Int      @default(0)
  createdById      String
  createdAt        DateTime @default(now())

  scheduleGroup WorkScheduleGroup            @relation(fields: [scheduleGroupId], references: [id], onDelete: Restrict)
  createdBy     User                         @relation("WorkScheduleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  days          WorkScheduleDay[]
  assignments   EmployeeScheduleAssignment[]

  @@unique([scheduleGroupId, version])
  @@index([createdById])
}

model WorkScheduleDay {
  id                  String  @id @default(cuid())
  scheduleVersionId   String
  isoWeekday          Int
  isWorkday           Boolean @default(true)
  expectedStartSecond Int?
  expectedEndSecond   Int?

  scheduleVersion WorkScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)
  breaks          WorkScheduleBreak[]

  @@unique([scheduleVersionId, isoWeekday])
}

model WorkScheduleBreak {
  id            String  @id @default(cuid())
  scheduleDayId String
  startSecond   Int
  endSecond     Int
  isPaid        Boolean @default(false)

  scheduleDay WorkScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)

  @@index([scheduleDayId])
}

model EmployeeScheduleAssignment {
  id                String    @id @default(cuid())
  organizationId    String
  employeeId        String
  scheduleVersionId String
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  createdById       String
  createdAt         DateTime  @default(now())

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee               Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  scheduleVersion        WorkScheduleVersion     @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("ScheduleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dailyAttendanceRecords DailyAttendanceRecord[]

  @@index([organizationId, employeeId, effectiveFrom])
  @@index([scheduleVersionId])
  @@index([createdById])
}

model AttendanceEvent {
  id              String               @id @default(cuid())
  organizationId  String
  employeeId      String
  occurredAt      DateTime
  direction       AttendanceDirection?
  source          AttendanceSource
  sourceReference String
  metadata        Json?
  createdById     String?
  createdAt       DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("AttendanceEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, source, sourceReference])
  @@index([organizationId, employeeId, occurredAt])
  @@index([createdById])
}

model DailyAttendanceRecord {
  id                          String               @id @default(cuid())
  organizationId              String
  employeeId                  String
  employmentRecordId          String
  scheduleAssignmentId        String?
  attendanceDate              DateTime             @db.Date
  timeZoneSnapshot            String
  scheduledStartAt            DateTime?
  scheduledEndAt              DateTime?
  lateGraceSeconds            Int                  @default(0)
  scheduledUnpaidBreakSeconds Int                  @default(0)
  firstTimeIn                 DateTime?
  lastTimeOut                 DateTime?
  workedSeconds               Int?
  lateSeconds                 Int?
  undertimeSeconds            Int?
  overtimeSeconds             Int?
  attendanceStatus            AttendanceStatus
  derivation                  AttendanceDerivation @default(RAW_EVENTS)
  hasUnclassifiedEvents       Boolean              @default(false)
  hasOutBeforeIn              Boolean              @default(false)
  correctionVersion           Int                  @default(0)
  remarks                     String?              @db.Text
  finalizedAt                 DateTime?
  lastCalculatedAt            DateTime
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee           Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentRecord   EmploymentRecord            @relation(fields: [employmentRecordId], references: [id], onDelete: Restrict)
  scheduleAssignment EmployeeScheduleAssignment? @relation(fields: [scheduleAssignmentId], references: [id], onDelete: Restrict)
  corrections        AttendanceCorrection[]

  @@unique([organizationId, employeeId, attendanceDate])
  @@index([organizationId, attendanceDate, attendanceStatus])
  @@index([employeeId, attendanceDate])
  @@index([employmentRecordId])
  @@index([scheduleAssignmentId])
}

model AttendanceCorrection {
  id                      String           @id @default(cuid())
  organizationId          String
  dailyAttendanceRecordId String
  revision                Int
  correctedTimeIn         DateTime?
  correctedTimeOut        DateTime?
  correctedStatus         AttendanceStatus
  reason                  String           @db.Text
  previousState           Json
  correctedState          Json
  createdById             String
  createdAt               DateTime         @default(now())

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dailyAttendanceRecord DailyAttendanceRecord @relation(fields: [dailyAttendanceRecordId], references: [id], onDelete: Restrict)
  createdBy             User                  @relation("AttendanceCorrectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([dailyAttendanceRecordId, revision])
  @@index([organizationId, createdAt])
  @@index([createdById])
}

model ParsedResume {
  id                   String   @id @default(cuid())
  documentId           String   @unique
  rawText              String   @db.Text
  summary              String?  @db.Text
  skills               Json     @default("[]")
  education            Json     @default("[]")
  workExperience       Json     @default("[]")
  certifications       Json     @default("[]")
  languages            Json     @default("[]")
  totalExperienceYears Float?
  matchScore           Float?
  matchDetails         Json?
  parsedAt             DateTime @default(now())
  parseError           String?  @db.Text

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model OnboardingProcess {
  id                   String           @id @default(cuid())
  applicationId        String           @unique
  status               OnboardingStatus @default(NOT_STARTED)
  startDate            DateTime
  targetCompletionDate DateTime?
  completedAt          DateTime?
  notes                String?          @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tasks       OnboardingTask[]

  @@index([status])
  @@index([startDate])
}

model OnboardingTask {
  id                  String               @id @default(cuid())
  onboardingProcessId String
  title               String
  description         String?              @db.Text
  type                OnboardingTaskType   @default(DOCUMENT)
  status              OnboardingTaskStatus @default(PENDING)
  isRequired          Boolean              @default(true)
  dueDate             DateTime?
  submittedAt         DateTime?
  verifiedAt          DateTime?
  verifiedById        String?
  reviewerNotes       String?              @db.Text
  fileName            String?
  fileType            String?
  fileSize            Int?
  storageKey          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  onboardingProcess OnboardingProcess @relation(fields: [onboardingProcessId], references: [id], onDelete: Cascade)
  verifiedBy        User?             @relation(fields: [verifiedById], references: [id])

  @@index([onboardingProcessId])
  @@index([status])
  @@index([type])
  @@index([verifiedById])
}

model RecruitmentDocument {
  id            String                    @id @default(cuid())
  applicationId String
  type          RecruitmentDocumentType
  title         String
  status        RecruitmentDocumentStatus @default(PENDING)
  isRequired    Boolean                   @default(true)
  isConditional Boolean                   @default(false)
  notes         String?                   @db.Text
  fileName      String?
  fileType      String?
  fileSize      Int?
  storageKey    String?
  verifiedAt    DateTime?
  verifiedById  String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedBy  User?       @relation(fields: [verifiedById], references: [id])

  @@unique([applicationId, type])
  @@index([applicationId])
  @@index([status])
  @@index([verifiedById])
}
