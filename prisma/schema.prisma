generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZATION_ADMIN
  HR_ADMIN
  HIRING_MANAGER
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum RequirementType {
  SKILL
  EDUCATION
  EXPERIENCE
  CERTIFICATION
  OTHER
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  INITIAL_SCREENING
  TECHNICAL
  BEHAVIORAL
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EvaluationRecommendation {
  STRONGLY_RECOMMEND
  RECOMMEND
  MAYBE
  DO_NOT_RECOMMEND
}

enum AssessmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  PASSED
  FAILED
  EXPIRED
  CANCELLED
}

enum AssessmentType {
  TECHNICAL
  SKILLS
  COGNITIVE
  BEHAVIORAL
  ROLE_SPECIFIC
  OTHER
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum PayFrequency {
  ANNUAL
  MONTHLY
  BIWEEKLY
  WEEKLY
  HOURLY
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  logoUrl        String?
  careersEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]
  jobs  Job[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(HR_ADMIN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  statusChanges       ApplicationStatusHistory[]
  interviews          Interview[]
  evaluations         CandidateEvaluation[]
  evaluationsAssessed Assessment[]
  offersCreated       Offer[]                    @relation("OfferCreatedBy")
  offersApproved      Offer[]                    @relation("OfferApprovedBy")

  @@index([organizationId])
}

model Job {
  id               String      @id @default(cuid())
  organizationId   String
  title            String
  slug             String
  department       String
  employmentType   String
  location         String
  description      String      @db.Text
  responsibilities String      @db.Text
  qualifications   String      @db.Text
  requirements     String      @db.Text
  status           JobStatus   @default(DRAFT)
  publishedAt      DateTime?
  closingDate      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  structuredReqs JobRequirement[]
  applications   Application[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([publishedAt])
}

model JobRequirement {
  id          String          @id @default(cuid())
  jobId       String
  name        String
  type        RequirementType @default(SKILL)
  description String?         @db.Text
  isRequired  Boolean         @default(true)
  createdAt   DateTime        @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Applicant {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  documents    Document[]

  @@index([email])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  applicantId String
  status      ApplicationStatus @default(APPLIED)
  coverLetter String            @db.Text
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job         Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant   Applicant                  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  documents   Document[]
  history     ApplicationStatusHistory[]
  interviews  Interview[]
  assessments Assessment[]
  offers      Offer[]

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
  @@index([status])
  @@index([appliedAt])
}

model Document {
  id            String   @id @default(cuid())
  applicantId   String
  applicationId String?
  fileName      String
  fileType      String
  fileSize      Int
  storageKey    String
  createdAt     DateTime @default(now())

  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@index([applicationId])
}

model ApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus
  toStatus      ApplicationStatus
  changedById   String
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User        @relation(fields: [changedById], references: [id])

  @@index([applicationId])
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String
  interviewerId   String
  scheduledAt     DateTime
  durationMinutes Int             @default(45)
  type            InterviewType   @default(INITIAL_SCREENING)
  location        String?
  meetingUrl      String?
  notes           String?         @db.Text
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User                 @relation(fields: [interviewerId], references: [id])
  evaluation  CandidateEvaluation?

  @@index([applicationId])
  @@index([interviewerId])
  @@index([status])
  @@index([scheduledAt])
}

model CandidateEvaluation {
  id                  String                    @id @default(cuid())
  interviewId         String                    @unique
  communicationScore  Int
  technicalScore      Int
  problemSolvingScore Int
  experienceScore     Int
  cultureFitScore     Int
  overallScore        Float
  recommendation      EvaluationRecommendation
  comments            String                    @db.Text
  evaluatedById       String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluatedBy User      @relation(fields: [evaluatedById], references: [id])

  @@index([interviewId])
  @@index([evaluatedById])
}

model Assessment {
  id            String           @id @default(cuid())
  applicationId String
  title         String
  type          AssessmentType   @default(TECHNICAL)
  description   String?          @db.Text
  dueDate       DateTime?
  status        AssessmentStatus @default(ASSIGNED)
  score         Float?
  maxScore      Float?
  passingScore  Float?
  submittedAt   DateTime?
  evaluatedAt   DateTime?
  evaluatorId   String?
  reviewerNotes String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evaluator   User?       @relation(fields: [evaluatorId], references: [id])

  @@index([applicationId])
  @@index([status])
  @@index([evaluatorId])
}

model Offer {
  id              String       @id @default(cuid())
  applicationId   String
  salary          Float
  payFrequency    PayFrequency @default(MONTHLY)
  employmentType  String
  startDate       DateTime
  expirationDate  DateTime?
  benefits        String?      @db.Text
  allowances      String?      @db.Text
  additionalTerms String?      @db.Text
  notes           String?      @db.Text
  status          OfferStatus  @default(DRAFT)
  createdById     String
  approvedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("OfferCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?       @relation("OfferApprovedBy", fields: [approvedById], references: [id])

  @@index([applicationId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}
